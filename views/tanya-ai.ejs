                <div class="mb-3">
                    <label for="pertanyaan" class="form-label">Pertanyaan Anda</label>
                    <textarea class="form-control" id="pertanyaan" rows="3" placeholder="Contoh: Beras 5kg masih ada?"></textarea>
                </div>
                <button type="button" class="btn btn-primary" onclick="alert('Fitur balasan AI dummy akan aktif di Sprint 2!')">Kirim Pertanyaan</button>
            </form>
        </section>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/script.js"></script>
</body>
</html>