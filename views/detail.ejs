<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Produk - Toko Sembako Ariesta</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>
    
    <main class="container my-4">
        <% if (error) { %>
            <div class="alert alert-danger" role="alert">
                <h4>Oops!</h4>
                <p><%= error %></p>
                <a href="/produk" class="btn btn-secondary">Kembali ke Daftar Produk</a>
            </div>
        <% } else { %>
            <article class="card p-4">
                <h1><%= product.name %></h1>
                <p><strong>Kategori:</strong> <%= product.category %></p>
                <p><strong>Harga:</strong> Rp <%= product.price.toLocaleString('id-ID') %></p>
                <p><strong>Stok Tersedia:</strong> <%= product.stock %> unit</p>
                <div>
                    <a href="/produk" class="btn btn-secondary">Kembali</a>
                </div>
            </article>
        <% } %>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/script.js"></script>
</body>
</html>