<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daftar Produk - Toko Sembako Ariesta</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>
    
    <main class="container my-4">
        <h1>Daftar Produk Sembako</h1>
        
        <form action="/produk" method="GET" class="row g-3 my-3">
            <div class="col-auto">
                <input type="text" name="search" class="form-control" placeholder="Cari produk..." value="<%= typeof search !== 'undefined' ? search : '' %>">
            </div>
            <div class="col-auto">
                <select name="kategori" class="form-select">
                    <option value="">Semua Kategori</option>
                    <option value="sembako" <%= typeof kategori !== 'undefined' && kategori === 'sembako' ? 'selected' : '' %>>Sembako</option>
                    <option value="protein" <%= typeof kategori !== 'undefined' && kategori === 'protein' ? 'selected' : '' %>>Protein</option>
                    <option value="bumbu" <%= typeof kategori !== 'undefined' && kategori === 'bumbu' ? 'selected' : '' %>>Bumbu</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-secondary">Filter</button>
            </div>
        </form>

        <section class="row">
            <% if (products.length > 0) { %>
                <% products.forEach(product => { %>
                    <article class="col-md-4 mb-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title"><%= product.name %></h5>
                                <p class="card-text">Kategori: <%= product.category %></p>
                                <p class="card-text">Harga: Rp <%= product.price.toLocaleString('id-ID') %></p>
                                <p class="card-text">Stok: <%= product.stock %></p>
                                <a href="/produk/<%= product.id %>" class="btn btn-primary btn-sm">Lihat Detail</a>
                            </div>
                        </div>
                    </article>
                <% }) %>
            <% } else { %>
                <p class="text-danger">Produk tidak ditemukan.</p>
            <% } %>
        </section>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/script.js"></script>
</body>
</html>