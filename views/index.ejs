<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Beranda - Toko Sembako Ariesta</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>
    
    <main class="container my-4">
        <section class="p-5 mb-4 bg-light rounded-3 text-center">
            <h1>Selamat Datang di Toko Sembako Ariesta</h1>
            <p class="lead">Belanja kebutuhan pokok jadi lebih mudah, cepat, dan transparan.</p>
            <a href="/produk" class="btn btn-primary">Lihat Daftar Produk</a>
        </section>

        <section>
            <h2>Produk Pilihan</h2>
            <div class="row">
                <% products.forEach(product => { %>
                    <article class="col-md-4 mb-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title"><%= product.name %></h5>
                                <p class="card-text">Harga: Rp <%= product.price.toLocaleString('id-ID') %></p>
                                <a href="/produk/<%= product.id %>" class="btn btn-outline-primary btn-sm">Detail</a>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/script.js"></script>
</body>
</html>